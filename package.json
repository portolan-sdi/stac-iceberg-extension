{
  "name": "stac-iceberg-extension",
  "version": "1.1.0",
  "description": "STAC Iceberg Extension — Apache Iceberg table metadata for STAC Collections",
  "scripts": {
    "test": "npm run check-markdown && npm run check-version && npm run check-examples",
    "check-markdown": "remark . --frail",
    "check-version": "node scripts/check-version.js",
    "check-examples": "stac-node-validator examples/*.json --schemaMap \"https://schemas.portolan-sdi.org/incubating/iceberg/v$npm_package_version/schema.json=./json-schema/v$npm_package_version/schema.json\"",
    "format-examples": "stac-node-validator examples/*.json --schemaMap \"https://schemas.portolan-sdi.org/incubating/iceberg/v$npm_package_version/schema.json=./json-schema/v$npm_package_version/schema.json\" --format"
  },
  "devDependencies": {
    "stac-node-validator": "^1.3.2",
    "remark-cli": "^12.0.0",
    "remark-lint": "^10.0.0",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "remark-validate-links": "^13.0.0"
  }
}
